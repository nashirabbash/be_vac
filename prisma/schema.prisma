generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  hospitalName String
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  deviceUsers TrDeviceUser[]
  histories   History[]
}

model Device {
  id         Int       @id @default(autoincrement())
  qrKey      String    @unique
  isProduced Boolean   @default(true)
  latitude   Float?
  longitude  Float?
  lastSeenAt DateTime?
  isOnline   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  deviceUsers TrDeviceUser[]
  histories   History[]
}

model TrDeviceUser {
  id        Int      @id @default(autoincrement())
  userId    Int
  deviceId  Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  device Device @relation(fields: [deviceId], references: [id])
}

model History {
  id          Int      @id @default(autoincrement())
  userId      Int
  deviceId    Int
  sessionDate String
  title       String
  date        String
  mode        String
  duration    String
  createdAt   DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  device Device @relation(fields: [deviceId], references: [id])
}

model AuditLog {
  id           Int      @id @default(autoincrement())
  userId       Int?
  username     String?
  hospitalName String?
  deviceId     String?
  action       String
  details      String?
  timestamp    DateTime @default(now())
  createdAt    DateTime @default(now())
}
